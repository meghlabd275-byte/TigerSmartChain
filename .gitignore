# Rust
target/
**/*.rs.bk

# Go
bin/
tigersmartchaind
tigerscan-api

# Node / Next.js
node_modules/
.next/
out/
build/
dist/
.env*.local

# IDEs
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db

# C/C++ build artifacts
*.o
*.a
*.so

# TypeScript build info
*.tsbuildinfo

# C++ test binaries
crypto_cpp/crypto_test

# Node runtime data (chain, state, P2P identity key)
node/data/

# Go compiled binaries
/explorer/cli
/explorer/tigerscan-api

# Vendored third-party sources that must not be ignored. blst keeps its
# per-format assembly under a directory called build/, which the general
# "build/" rule above would otherwise drop from the repository.
!blob_processor/cpp/third_party/blst/build/
!blob_processor/cpp/third_party/blst/build/**

# Python bytecode caches
__pycache__/
*.py[cod]
